# -----------------------------------
# Path Exports
# -----------------------------------
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"

# -----------------------------------
# Bun
# -----------------------------------
export BUN_INSTALL="$HOME/.bun"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# -----------------------------------
# Editor
# -----------------------------------
export EDITOR=nvim
export VISUAL=nvim

# -----------------------------------
# Bat
# -----------------------------------
export BAT_THEME="OneHalfDark"

# -----------------------------------
# fhm
# -----------------------------------
FNM_PATH="/opt/homebrew/opt/fnm/bin"
if [ -d "$FNM_PATH" ]; then
  eval "`fnm env`"
fi

