# Color Settings
background = #282c34
foreground= #abb2bf
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#d19a66
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf

# Font Settings
font-family = "FiraCode Nerd Font"
font-synthetic-style= false
font-size = 13.5
font-thicken = true

# Cursor Settings
shell-integration-features = no-cursor
cursor-style = block
cursor-click-to-move = true

# Window Settings
window-padding-x = 10
window-padding-y = 20
window-height = 50
window-width = 200
title = "Ghostty"

# Misc
copy-on-select = true
background-opacity = 0.9
background-blur-radius = 20
confirm-close-surface = false
initial-command = /bin/zsh -l -c "tmux attach || tmux new-session -As Main"
confirm-close-surface = false

# Keybindings
keybind = alt+s=new_split:down
keybind = alt+v=new_split:right
keybind = alt+f=toggle_maximize
